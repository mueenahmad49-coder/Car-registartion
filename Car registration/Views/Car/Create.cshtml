@model CarRecordApp.Models.Car

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 border p-4 shadow-sm bg-light rounded">
            <h3 class="mb-3 text-center">Car Registration</h3>
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="CarName" class="form-label">Car Name</label>
                    <input asp-for="CarName" class="form-control" />
                    <span asp-validation-for="CarName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="OwnerName" class="form-label">Owner Name</label>
                    <input asp-for="OwnerName" class="form-control" />
                    <span asp-validation-for="OwnerName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ModelYear" class="form-label">Model Year (2000 - 2021)</label>
                    <input asp-for="ModelYear" type="number" class="form-control" />
                    <span asp-validation-for="ModelYear" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ManufacturedDate" class="form-label">Manufactured Date</label>
                    <input asp-for="ManufacturedDate" type="date" class="form-control" />
                    <span asp-validation-for="ManufacturedDate" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ChassisNumber" class="form-label">Chassis Number (10 Digits)</label>
                    <input asp-for="ChassisNumber" class="form-control" />
                    <span asp-validation-for="ChassisNumber" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-success">Save Car</button>
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>