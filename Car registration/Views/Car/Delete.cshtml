@model CarRecordApp.Models.Car

<div class="container mt-4 text-center">
    <div class="row justify-content-center">
        <div class="col-md-5 border p-4 shadow-sm bg-white rounded">
        
            <h3 class="text-danger mb-3">Are you sure?</h3>
            <p>Do you really want to delete the record for <strong>@Model.CarName</strong> (Owner: @Model.OwnerName)?</p>
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger px-4 me-2">Yes, Delete</button>
                <a asp-action="Index" class="btn btn-secondary px-4">No, Cancel</a>
            </form>
        </div>
    </div>
</div>